# Serverless Kafka (Upstash)
UPSTASH_KAFKA_REST_URL=https://your-upstash-kafka-url.upstash.io
UPSTASH_KAFKA_REST_USERNAME=your_username
UPSTASH_KAFKA_REST_PASSWORD=your_password

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-cool-entity-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Providers (Fase 2)
# heuristic: fallback determinista, sin red (default para desarrollo y tests).
# openai: OpenAI API; ollama: servidor local compatible con OpenAI.
# Para Ollama: SENTINEL_LLM_PROVIDER=ollama y SENTINEL_LLM_MODEL=llama3.1.
SENTINEL_LLM_PROVIDER=heuristic
SENTINEL_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=

# Ollama (solo si SENTINEL_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama-local