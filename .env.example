# Queue for OTLP ingestion
# inline: procesa en el mismo request (default local/tests).
# qstash: publica en Upstash QStash y procesa via /internal/otel/process.
# Usa el endpoint de la region de tu proyecto Upstash; el endpoint global puede
# responder 404 si el token pertenece a otra region.
SENTINEL_QUEUE_PROVIDER=inline
QSTASH_TOKEN=
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
SENTINEL_OTEL_WORKER_URL=

# Notifier (Fase 4)
# console: imprime en logs (default local/tests).
# webhook/slack: envia {"text": ...} a un Incoming Webhook compatible con Slack.
SENTINEL_NOTIFIER_PROVIDER=console
SENTINEL_NOTIFIER_WEBHOOK_URL=
SENTINEL_NOTIFIER_TIMEOUT=5
SENTINEL_NOTIFIER_MAX_RETRIES=2
SENTINEL_NOTIFIER_BACKOFF_SECONDS=0.5

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-cool-entity-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Embeddings (Fase 3: RAG)
# gemini: usa Gemini Embeddings; requiere GEMINI_API_KEY.
# disabled: mantiene InMemoryRepository y desactiva la busqueda semantica.
SENTINEL_EMBEDDING_PROVIDER=disabled
SENTINEL_EMBEDDING_MODEL=gemini-embedding-2
SENTINEL_EMBEDDING_API_KEY=
SENTINEL_EMBEDDING_DIMENSIONS=384
SENTINEL_EMBEDDING_TIMEOUT=20

# Observability (Langfuse)
# noop: desactiva el envio de trazas (default).
# langfuse: requiere LANGFUSE_PUBLIC_KEY y LANGFUSE_SECRET_KEY.
SENTINEL_OBSERVABILITY_PROVIDER=noop
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# LLM Providers (Fase 2)
# heuristic: fallback determinista, sin red (default para desarrollo y tests).
# groq: free tier recomendado, compatible con OpenAI.
# gemini: free tier de Google, compatible con OpenAI.
# openrouter: modelos con sufijo :free; requiere SENTINEL_LLM_MODEL.
# openai-compatible: cualquier endpoint compatible; requiere base URL y modelo.
# ollama: servidor local compatible con OpenAI.
SENTINEL_LLM_PROVIDER=heuristic
SENTINEL_LLM_MODEL=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_STRUCTURED_METHOD=function_calling
SENTINEL_LLM_TIMEOUT=30
SENTINEL_LLM_MAX_RETRIES=2

# Groq (recomendado para la nube gratuita)
GROQ_API_KEY=

# Google Gemini (respaldo)
GEMINI_API_KEY=

# OpenRouter (opcional)
OPENROUTER_API_KEY=

# OpenAI (opcional, no tiene free tier)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Ollama (solo si SENTINEL_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama-local

# Prueba de integracion real (opt-in, consume cuota del proveedor)
SENTINEL_LLM_INTEGRATION=0
SENTINEL_LLM_INTEGRATION_PROVIDER=groq

# Prueba real de Neon/pgvector + Gemini (opt-in, escribe y borra una fila)
SENTINEL_RAG_INTEGRATION=0

# Ingesta OpenTelemetry Demo (OTLP HTTP)
# Si se define, /events y /ingest/otel/v1/logs exigen X-Ingest-Key.
SENTINEL_INGEST_API_KEY=
SENTINEL_OTEL_MAX_EVENTS=3
SENTINEL_OTEL_DEDUP_TTL=60

# Dashboard y proteccion de la ingesta
# SENTINEL_DASHBOARD_MAX_EVENTS: eventos en memoria visibles en /dashboard.
# SENTINEL_RATE_LIMIT_PER_MINUTE: limite por cliente en 60 s; 0 lo desactiva.
# SENTINEL_DASHBOARD_USER/PASSWORD: si ambos se definen, /dashboard y
# /dashboard/events exigen HTTP Basic. Si se define solo uno, responden 503.
SENTINEL_DASHBOARD_MAX_EVENTS=100
SENTINEL_RATE_LIMIT_PER_MINUTE=120
SENTINEL_DASHBOARD_USER=
SENTINEL_DASHBOARD_PASSWORD=
