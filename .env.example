# Serverless Kafka (Upstash)
UPSTASH_KAFKA_REST_URL=https://your-upstash-kafka-url.upstash.io
UPSTASH_KAFKA_REST_USERNAME=your_username
UPSTASH_KAFKA_REST_PASSWORD=your_password

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-cool-entity-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Providers (Fase 2)
# heuristic: fallback determinista, sin red (default para desarrollo y tests).
# groq: free tier recomendado, compatible con OpenAI.
# gemini: free tier de Google, compatible con OpenAI.
# openrouter: modelos con sufijo :free; requiere SENTINEL_LLM_MODEL.
# openai-compatible: cualquier endpoint compatible; requiere base URL y modelo.
# ollama: servidor local compatible con OpenAI.
SENTINEL_LLM_PROVIDER=heuristic
SENTINEL_LLM_MODEL=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_STRUCTURED_METHOD=function_calling
SENTINEL_LLM_TIMEOUT=30
SENTINEL_LLM_MAX_RETRIES=2

# Groq (recomendado para la nube gratuita)
GROQ_API_KEY=

# Google Gemini (respaldo)
GEMINI_API_KEY=

# OpenRouter (opcional)
OPENROUTER_API_KEY=

# OpenAI (opcional, no tiene free tier)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Ollama (solo si SENTINEL_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama-local

# Prueba de integracion real (opt-in, consume cuota del proveedor)
SENTINEL_LLM_INTEGRATION=0
SENTINEL_LLM_INTEGRATION_PROVIDER=groq
